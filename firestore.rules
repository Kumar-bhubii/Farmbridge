rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // User profiles
    match /users/{uid} {
      allow create: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Crop listings
    match /listings/{listingId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Buyer requirements
    match /demands/{demandId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Enquiries
    match /enquiries/{enquiryId} {
      allow read: if signedIn()
        && (
          resource.data.buyerUid == request.auth.uid ||
          resource.data.farmerUid == request.auth.uid ||
          isAdmin()
        );

      allow create: if signedIn()
        && (
          request.resource.data.buyerUid == request.auth.uid ||
          request.resource.data.farmerUid == request.auth.uid
        );

      allow update: if signedIn()
        && (
          resource.data.buyerUid == request.auth.uid ||
          resource.data.farmerUid == request.auth.uid ||
          isAdmin()
        );

      allow delete: if isAdmin();
    }

    // Moderation reports
    match /reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // Deny access to everything not explicitly allowed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}